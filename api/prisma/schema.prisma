generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //relationMode = "prisma"
}

model User {
  id           Int                @id @default(autoincrement())
  username     String             @unique
  email        String             @unique
  password     String
  name         String?
  preferences  Json?              // Store user preferences like preferred unit (km/miles), search radius
  favorites    UserFavorite[]
  reviews      UserReview[]
  visits       CoffeeShopVisit[]
  collections  UserCollection[]
  searchHistory SearchHistory[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CoffeeShop {
  id           Int                           @id @default(autoincrement())
  placeId      String                        @unique // Geoapify place ID
  name         String
  address      String
  latitude     Float
  longitude    Float
  phone        String?
  website      String?
  imageUrl     String?
  rating       Float?
  priceLevel   Int?                          // 1-4 price scale
  openingHours Json?                         // Store opening hours as JSON
  amenities    Json?                         // WiFi, outdoor seating, drive-thru, etc.
  description  String?
  city         String?
  state        String?
  country      String?
  source       String                        @default("Geoapify")
  isVerified   Boolean                       @default(false) // For admin verification
  favorites    UserFavorite[]
  reviews      UserReview[]
  visits       CoffeeShopVisit[]
  categories   CoffeeShopCategoryMapping[]
  collections  CollectionCoffeeShop[]
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([latitude, longitude])
  @@index([city])
  @@index([rating])
}

model UserFavorite {
  id           Int        @id @default(autoincrement())
  userId       Int
  coffeeShopId Int
  notes        String?    // Personal notes about the coffee shop
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, coffeeShopId])
}

model UserReview {
  id            Int        @id @default(autoincrement())
  userId        Int
  coffeeShopId  Int
  rating        Int        // 1-5 stars
  title         String?
  comment       String?
  visitDate     DateTime?
  isRecommended Boolean    @default(true)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coffeeShop    CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, coffeeShopId])
}

model SearchHistory {
  id           Int      @id @default(autoincrement())
  userId       Int?     // Optional for anonymous searches
  location     String
  latitude     Float?
  longitude    Float?
  radius       Float
  unit         String   // 'km' or 'miles'
  resultsCount Int      @default(0)
  ipAddress    String?  // For anonymous tracking
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model CoffeeShopVisit {
  id           Int        @id @default(autoincrement())
  userId       Int
  coffeeShopId Int
  visitDate    DateTime   @default(now())
  notes        String?
  photoUrls    Json?      // Array of photo URLs
  rating       Int?       // Quick rating 1-5
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([coffeeShopId])
}

model CoffeeShopCategory {
  id          Int                           @id @default(autoincrement())
  name        String                        @unique
  description String?
  color       String?                       // For UI display
  icon        String?                       // Icon name or URL
  coffeeShops CoffeeShopCategoryMapping[]
  createdAt   DateTime                      @default(now())
}

model CoffeeShopCategoryMapping {
  id           Int                @id @default(autoincrement())
  coffeeShopId Int
  categoryId   Int
  coffeeShop   CoffeeShop         @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  category     CoffeeShopCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([coffeeShopId, categoryId])
}

model UserCollection {
  id          Int                    @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  isPublic    Boolean                @default(false)
  color       String?                // For UI theming
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coffeeShops CollectionCoffeeShop[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

// Updated schema.prisma - Add these fields to CollectionCoffeeShop model

model CollectionCoffeeShop {
  id           Int            @id @default(autoincrement())
  collectionId Int
  coffeeShopId Int
  notes        String?
  order        Int            @default(0)
  isVisited    Boolean        @default(false)  // NEW: Track if user has visited
  visitedDate  DateTime?                       // NEW: When they visited
  personalRating Int?                          // NEW: Personal rating (1-5)
  tags         Json?                           // NEW: Personal tags
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  coffeeShop   CoffeeShop     @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt       // NEW: Track updates

  @@unique([collectionId, coffeeShopId])
}

